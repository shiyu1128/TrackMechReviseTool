<Window x:Class="TrackMechReviseTool.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackMechReviseTool - 元素示踪机理编辑器"
        Width="1480" Height="880" MinWidth="1100" MinHeight="680"
        Background="#F4F6F7" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#24343B" Padding="18,12">
            <DockPanel>
                <TextBlock Text="TrackMechReviseTool" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="化学反应动力学元素示踪" Foreground="#D6E2E6" Margin="18,4,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14,12,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="机理 .out" VerticalAlignment="Center" />
            <TextBox x:Name="OutPathBox" Grid.Row="0" Grid.Column="1" Margin="0,0,6,6" IsReadOnly="True" />
            <Button Grid.Row="0" Grid.Column="2" Content="选择文件" Margin="0,0,10,6" Click="BrowseOut_Click" ToolTip="选择 Chemkin 输出文件" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="标记元素" VerticalAlignment="Center" />
            <ComboBox x:Name="ElementBox" Grid.Row="0" Grid.Column="4" Margin="0,0,8,6" />
            <Button x:Name="GeneratePlanButton" Grid.Row="0" Grid.Column="5" Content="生成计划" Margin="0,0,0,6" Click="GeneratePlan_Click" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="热力学 .dat" VerticalAlignment="Center" />
            <TextBox x:Name="ThermoPathBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" IsReadOnly="True" />
            <Button Grid.Row="1" Grid.Column="2" Content="选择文件" Margin="0,0,10,0" Click="BrowseThermo_Click" ToolTip="选择 NASA 热力学文件" />
            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="载入计划" Click="LoadPlan_Click" />
                <Button Content="保存计划" Click="SavePlan_Click" />
                <Button Content="校验计划" Background="#176B87" Foreground="White" Click="ValidatePlan_Click" />
                <Button Content="输出 .inp" Click="WriteMechanism_Click" />
                <Button Content="输出 .dat" Click="WriteThermo_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="GenerationPanel" Grid.Row="2" Margin="14,4,14,8" Padding="10,8"
                Background="White" BorderBrush="#B8C4CA" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GenerationProgressText" VerticalAlignment="Center" Foreground="#24343B"
                           Text="正在计算标记反应..." />
                <ProgressBar x:Name="GenerationProgressBar" Grid.Column="1" Height="16"
                             Minimum="0" Maximum="1" Value="0" />
            </Grid>
        </Border>

        <Border x:Name="RevNotice" Grid.Row="3" Margin="14,4,14,8" Padding="10,7"
                Background="#FFF4D6" BorderBrush="#D89A23" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="RevNoticeText" Foreground="#704B00" TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="PlanGrid" Grid.Row="4" Margin="14,0,14,10"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFB"
                  BorderBrush="#B8C4CA" BorderThickness="1" SelectionUnit="FullRow"
                  EnableRowVirtualization="False" EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="False"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="False">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="False" Background="#E6EDF0">
                                            <Expander.Header>
                                                <DockPanel Margin="6,4">
                                                    <TextBlock Text="{Binding Name, StringFormat=反应 {0}}"
                                                               FontWeight="SemiBold" Foreground="#24343B" />
                                                    <TextBlock Text="{Binding Items[0].SourceEquation}"
                                                               Margin="18,0,0,0" Foreground="#52636B" />
                                                </DockPanel>
                                            </Expander.Header>
                                            <Border Background="White" BorderBrush="#CBD5DC" BorderThickness="0,1,0,0">
                                                <ItemsPresenter />
                                            </Border>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="3,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                            <Setter Property="Background" Value="#EDF2F4" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#24343B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PlanStatus}" Value="NeedsRevParameters">
                            <Setter Property="Background" Value="#FFF4D6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PlanStatus}" Value="Invalid">
                            <Setter Property="Background" Value="#FCE3E3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="目录" Binding="{Binding SequenceLabel}" IsReadOnly="True" Width="65" />
                <DataGridTextColumn Header="类型" Binding="{Binding RowKind}" IsReadOnly="True" Width="72" />
                <DataGridTextColumn Header="标记数" Binding="{Binding MarkedAtomCount}" IsReadOnly="True" Width="55" />
                <DataGridTextColumn Header="反应方程式" Binding="{Binding DisplayEquation}" IsReadOnly="True" Width="250" />
                <DataGridTemplateColumn Header="采用" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOriginal}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="gf" Binding="{Binding Gf}" IsReadOnly="True" Width="40" />
                <DataGridTemplateColumn Header="正向概率" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ForwardProbabilityOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding ForwardProbability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding ForwardProbabilityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                      IsEditable="True" IsTextSearchEnabled="False"
                                      ToolTip="{Binding ForwardProbabilityHint}"
                                      Padding="4,1" MinHeight="24" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="gr" Binding="{Binding Gr}" IsReadOnly="True" Width="40" />
                <DataGridTemplateColumn Header="逆向概率" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ReverseProbabilityOptions}"
                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding ReverseProbability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding ReverseProbabilityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                      IsEnabled="{Binding CanEditReverseProbability}"
                                      IsEditable="True" IsTextSearchEnabled="False"
                                      ToolTip="{Binding ReverseProbabilityHint}"
                                      Padding="4,1" MinHeight="24" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="REV 判定" Binding="{Binding ExplicitRevRequirement}" IsReadOnly="True" Width="125" />
                <DataGridTextColumn Header="REV A" Binding="{Binding RevA}" Width="105" />
                <DataGridTextColumn Header="REV n" Binding="{Binding RevN}" Width="75" />
                <DataGridTextColumn Header="REV E" Binding="{Binding RevE}" Width="95" />
                <DataGridTextColumn Header="状态" Binding="{Binding PlanStatus}" IsReadOnly="True" Width="130" />
                <DataGridTextColumn Header="提示" Binding="{Binding ValidationMessage}" IsReadOnly="True" Width="360" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5" Background="White" BorderBrush="#CBD5DC" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#52636B" />
                <TextBlock x:Name="StatusText" Text="请选择 .out 文件开始。" Foreground="#24343B" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
